PORT=3000
ALICE_TOKEN=change_me_to_secure_token_min_20_chars
DISABLE_HMAC=false
NODE_ENV=development
LOG_LEVEL=info

# URL локального сервера для облачной функции
WEBHOOK_URL=https://your-domain.com

# Notion Integration (optional)
NOTION_TOKEN="создай интеграцию в notion, там интеграционный токен"
NOTION_DATABASE_ID="ссылка от БД Notion перед ?v="

# Full disk search settings
ENABLE_FULL_DISK_SEARCH=true
FULL_SEARCH_TIMEOUT=60000

# Kinopoisk integration
KP_TOKEN='токен у бота @kinopoiskdev_bot'
